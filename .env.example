# Copy to .env in the repository root. Values below are local examples only.
APP_NAME=Health Management System
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Relative paths are resolved from the repository root.
HEALTH_DB_PATH=backend/data/health.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=5173
# Leave empty to use Vite's /api and /health proxy in local development.
VITE_API_BASE_URL=
# Optional override; empty uses http://127.0.0.1:<BACKEND_PORT>.
API_PROXY_TARGET=
